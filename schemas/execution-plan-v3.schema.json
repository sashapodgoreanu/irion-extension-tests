{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irion.example/schemas/extension-qa/execution-plan/v3",
  "title": "Irion DuckDB extension QA execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runtime", "cases"],
  "properties": {
    "schemaVersion": {"const": 3},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duckdbVersion", "ciToolsVersion"],
      "properties": {
        "duckdbVersion": {"type": "string", "minLength": 1},
        "ciToolsVersion": {"type": "string", "minLength": 1}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "extensionName": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "profileName": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "serviceName": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "service": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {"$ref": "#/$defs/serviceName"},
        "type": {"enum": ["python-http", "squid", "httpfs-minio", "postgres", "sqlserver"]},
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "version": {"type": "string", "minLength": 1},
        "database": {"type": "string", "minLength": 1},
        "username": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {"type": {"enum": ["google-bigquery"]}}
    },
    "testConfig": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "excludedExtensions", "staticallyLoadedExtensions"],
          "properties": {
            "kind": {"const": "generated"},
            "description": {"type": "string", "minLength": 1},
            "excludedExtensions": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/extensionName"}
            },
            "staticallyLoadedExtensions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/extensionName"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": {"const": "upstream"},
            "path": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tests", "services"],
      "properties": {
        "name": {"$ref": "#/$defs/profileName"},
        "tests": {"type": "string", "minLength": 1},
        "services": {"type": "array", "items": {"$ref": "#/$defs/service"}},
        "testConfig": {"$ref": "#/$defs/testConfig"}
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"$ref": "#/$defs/extensionName"},
        "installFrom": {"$ref": "#/$defs/extensionName"}
      }
    },
    "ignoredTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/profileName"}
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "execution", "extensions", "ignoredTests"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "pin", "submodules"],
          "properties": {
            "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
            "pin": {"type": "string", "minLength": 1},
            "submodules": {"enum": ["true", "false", "recursive"]}
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runner", "services", "prerequisites", "capabilities", "profiles"],
          "properties": {
            "runner": {"enum": ["standard", "postgres-scanner", "mssql-release"]},
            "services": {"type": "array", "items": {"$ref": "#/$defs/service"}},
            "prerequisites": {"type": "array", "items": {"$ref": "#/$defs/prerequisite"}},
            "capabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["squid", "docker", "docker-compose", "postgres-client", "google-cloud-auth"]}
            },
            "profiles": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/profile"}
            }
          }
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/extension"}
        },
        "ignoredTests": {
          "type": "array",
          "items": {"$ref": "#/$defs/ignoredTest"}
        }
      }
    }
  }
}
