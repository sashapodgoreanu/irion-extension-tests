{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irion.example/schemas/extension-qa/v2",
  "title": "Irion DuckDB extension QA configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "duckdb", "defaultExtensions", "testBatteries"],
  "properties": {
    "schemaVersion": {"const": 2},
    "duckdb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "ciToolsVersion"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "ciToolsVersion": {"type": "string", "minLength": 1}
      }
    },
    "defaultExtensions": {
      "type": "array",
      "items": {"$ref": "#/$defs/extension"}
    },
    "testBatteries": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/battery"}
    }
  },
  "$defs": {
    "extensionName": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "profileName": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "isUsed"],
      "properties": {
        "name": {"$ref": "#/$defs/extensionName"},
        "isUsed": {"type": "boolean"},
        "installFrom": {"$ref": "#/$defs/extensionName"}
      }
    },
    "generatedTestConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "staticallyLoadedExtensions"],
      "properties": {
        "kind": {"const": "generated"},
        "description": {"type": "string", "minLength": 1},
        "excludedExtensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/extensionName"}
        },
        "staticallyLoadedExtensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/extensionName"}
        }
      }
    },
    "upstreamTestConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {"const": "upstream"},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tests"],
      "properties": {
        "name": {"$ref": "#/$defs/profileName"},
        "tests": {"type": "string", "minLength": 1},
        "runtimeSetup": {"enum": ["none", "ducklake-postgres-15"]},
        "testConfig": {
          "oneOf": [
            {"$ref": "#/$defs/generatedTestConfig"},
            {"$ref": "#/$defs/upstreamTestConfig"}
          ]
        }
      }
    },
    "ignoredTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/profileName"}
        }
      }
    },
    "battery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isEnabled", "runner", "repository", "pin", "profiles"],
      "properties": {
        "isEnabled": {"type": "boolean"},
        "runner": {"enum": ["standard", "postgres-scanner", "mssql-release"]},
        "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "pin": {"type": "string", "minLength": 1},
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/profile"}
        },
        "submodules": {
          "oneOf": [
            {"type": "boolean"},
            {"enum": ["true", "false", "recursive"]}
          ]
        },
        "setup": {
          "enum": ["none", "httpfs-services", "ducklake-catalogs", "postgres-17", "sqlserver-2022"]
        },
        "extensions": {
          "type": "array",
          "items": {"$ref": "#/$defs/extension"}
        },
        "ignoredTests": {
          "type": "array",
          "items": {"$ref": "#/$defs/ignoredTest"}
        }
      }
    }
  }
}
