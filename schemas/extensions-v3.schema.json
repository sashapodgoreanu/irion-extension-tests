{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irion.example/schemas/extension-qa/v3",
  "title": "Irion DuckDB extension QA configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "duckdb",
    "defaultExtensions",
    "testBatteries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "duckdb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "ciToolsVersion"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "ciToolsVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "defaultExtensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extension"
      }
    },
    "testBatteries": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/battery"
      }
    }
  },
  "$defs": {
    "extensionName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "profileName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "serviceName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "simpleName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "isUsed"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/extensionName"
        },
        "isUsed": {
          "type": "boolean"
        },
        "installFrom": {
          "$ref": "#/$defs/extensionName"
        }
      }
    },
    "pythonHttpService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "port"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/serviceName"
        },
        "type": {
          "const": "python-http"
        },
        "port": {
          "$ref": "#/$defs/port"
        }
      }
    },
    "squidService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "port"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/serviceName"
        },
        "type": {
          "const": "squid"
        },
        "port": {
          "$ref": "#/$defs/port"
        }
      }
    },
    "httpfsMinioService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/serviceName"
        },
        "type": {
          "const": "httpfs-minio"
        }
      }
    },
    "postgresService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "version",
        "database",
        "port"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/serviceName"
        },
        "type": {
          "const": "postgres"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
        },
        "database": {
          "$ref": "#/$defs/simpleName"
        },
        "username": {
          "$ref": "#/$defs/simpleName"
        },
        "port": {
          "$ref": "#/$defs/port"
        }
      }
    },
    "sqlserverService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "version",
        "database",
        "port"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/serviceName"
        },
        "type": {
          "const": "sqlserver"
        },
        "version": {
          "const": "2022"
        },
        "database": {
          "$ref": "#/$defs/simpleName"
        },
        "username": {
          "$ref": "#/$defs/simpleName"
        },
        "port": {
          "$ref": "#/$defs/port"
        }
      }
    },
    "service": {
      "oneOf": [
        {
          "$ref": "#/$defs/pythonHttpService"
        },
        {
          "$ref": "#/$defs/squidService"
        },
        {
          "$ref": "#/$defs/httpfsMinioService"
        },
        {
          "$ref": "#/$defs/postgresService"
        },
        {
          "$ref": "#/$defs/sqlserverService"
        }
      ]
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "google-bigquery",
            "external-cloud-account"
          ]
        }
      }
    },
    "generatedTestConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "staticallyLoadedExtensions"
      ],
      "properties": {
        "kind": {
          "const": "generated"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "excludedExtensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/extensionName"
          }
        },
        "staticallyLoadedExtensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/extensionName"
          }
        }
      }
    },
    "upstreamTestConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "const": "upstream"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tests"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/profileName"
        },
        "tests": {
          "type": "string",
          "minLength": 1
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service"
          }
        },
        "testConfig": {
          "oneOf": [
            {
              "$ref": "#/$defs/generatedTestConfig"
            },
            {
              "$ref": "#/$defs/upstreamTestConfig"
            }
          ]
        }
      }
    },
    "ignoredTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/profileName"
          }
        }
      }
    },
    "battery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isEnabled",
        "runner",
        "repository",
        "pin",
        "services",
        "prerequisites",
        "profiles"
      ],
      "properties": {
        "isEnabled": {
          "type": "boolean"
        },
        "runner": {
          "enum": [
            "standard",
            "postgres-scanner",
            "mssql-release"
          ]
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "pin": {
          "type": "string",
          "minLength": 1
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service"
          }
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prerequisite"
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profile"
          }
        },
        "submodules": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "enum": [
                "true",
                "false",
                "recursive"
              ]
            }
          ]
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension"
          }
        },
        "ignoredTests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ignoredTest"
          }
        }
      }
    }
  }
}
