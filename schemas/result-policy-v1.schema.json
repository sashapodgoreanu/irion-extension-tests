{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irion.example/schemas/result-policy-v1.schema.json",
  "title": "DuckDB Extension QA Result Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaults", "overrides", "skipAuthorizations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "defaults": {"$ref": "#/$defs/thresholds"},
    "overrides": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/thresholds"},
          {
            "type": "object",
            "required": ["case"],
            "properties": {
              "case": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "profile": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
            }
          }
        ]
      }
    },
    "skipAuthorizations": {
      "type": "array",
      "items": {"$ref": "#/$defs/skipAuthorization"}
    }
  },
  "$defs": {
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumDiscovered": {"type": "integer", "minimum": 0},
        "minimumExecuted": {"type": "integer", "minimum": 0},
        "maximumSkipped": {"type": "integer", "minimum": 0},
        "case": {"type": "string"},
        "profile": {"type": "string"}
      }
    },
    "skipAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "profile", "category", "expected", "reason"],
      "properties": {
        "case": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "profile": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "category": {"const": "upstream_declared"},
        "expected": {"type": "integer", "minimum": 1},
        "reason": {"type": "string", "pattern": ".*\\S.*"}
      }
    }
  }
}
