{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irion.example/schemas/test-result-v1.schema.json",
  "title": "DuckDB Extension QA Test Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "battery",
    "runner",
    "status",
    "acceptedFailure",
    "exitCode",
    "reason",
    "startedAt",
    "finishedAt",
    "durationMs",
    "duckdbVersion",
    "upstream",
    "profiles",
    "extensions",
    "services"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "caseId": {"type": "string", "minLength": 1},
    "battery": {"type": "string", "minLength": 1},
    "runner": {"type": "string", "minLength": 1},
    "status": {"enum": ["passed", "failed", "accepted_failure"]},
    "acceptedFailure": {"type": "boolean"},
    "exitCode": {"type": "integer", "minimum": 0},
    "reason": {"type": ["string", "null"]},
    "startedAt": {"type": "string", "format": "date-time"},
    "finishedAt": {"type": "string", "format": "date-time"},
    "durationMs": {"type": "integer", "minimum": 0},
    "duckdbVersion": {"type": ["string", "null"]},
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pin", "commit"],
      "properties": {
        "repository": {"type": ["string", "null"]},
        "pin": {"type": ["string", "null"]},
        "commit": {"type": ["string", "null"]}
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "filter",
          "status",
          "log",
          "summaryFound",
          "discovered",
          "executed",
          "passed",
          "failed",
          "skipped",
          "assertions"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "filter": {"type": ["string", "null"]},
          "status": {"enum": ["passed", "skipped", "failed", "invalid", "not_run"]},
          "log": {"type": ["string", "null"]},
          "summaryFound": {"type": "boolean"},
          "discovered": {"type": ["integer", "null"], "minimum": 0},
          "executed": {"type": ["integer", "null"], "minimum": 0},
          "passed": {"type": ["integer", "null"], "minimum": 0},
          "failed": {"type": ["integer", "null"], "minimum": 0},
          "skipped": {"type": ["integer", "null"], "minimum": 0},
          "assertions": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "installed", "loaded", "version", "installMode", "installedFrom"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "installed": {"type": ["boolean", "null"]},
          "loaded": {"type": ["boolean", "null"]},
          "version": {"type": ["string", "null"]},
          "installMode": {"type": ["string", "null"]},
          "installedFrom": {"type": ["string", "null"]}
        }
      }
    },
    "services": {
      "type": "array",
      "items": {"type": "object"}
    }
  }
}
