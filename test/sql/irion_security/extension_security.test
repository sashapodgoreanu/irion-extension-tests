# Irion hardening: use only the runner-owned local extension repository and
# reject community-signed extensions for both INSTALL and LOAD.

require-env LOCAL_EXTENSION_REPO

statement ok
SET custom_extension_repository = '{LOCAL_EXTENSION_REPO}';

statement ok
SET allow_community_extensions = false;

query T
SELECT current_setting('allow_community_extensions')::VARCHAR
----
false

# The battery bootstrap has already downloaded mssql from DuckDB Community and
# copied it into LOCAL_EXTENSION_REPO. FORCE INSTALL reads that community-signed
# binary from the local repository, but it must be rejected when community
# extension signing keys are disabled.
statement error
FORCE INSTALL mssql;
----
<REGEX>:.*signature.*

# The previously installed community binary is still present in the isolated
# extension home. Loading it must be rejected for the same trust-policy reason.
statement error
LOAD mssql;
----
<REGEX>:.*signature.*
