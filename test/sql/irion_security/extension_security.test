# Irion hardening: a local extension repository must not fall back to DuckDB
# Community, and community-signed extensions must not be loadable.

statement ok
SET custom_extension_repository = 'test/fixtures/empty-extension-repository';

statement ok
SET allow_community_extensions = false;

query T
SELECT current_setting('allow_community_extensions')::VARCHAR
----
false

# pivot_table is a DuckDB Community extension. With the custom repository
# redirected to the repository-owned empty folder, INSTALL must fail instead of
# reaching the public Community repository.
statement error
INSTALL pivot_table;

# The Irion battery installs mssql from DuckDB Community during setup, but this
# profile deliberately excludes it from LOAD. Once community extensions are
# disabled, loading that already-installed community binary must fail.
statement error
LOAD mssql;
