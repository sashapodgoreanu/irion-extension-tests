# Verify Irion can restrict extension installation to the local repository
# and reject DuckDB Community extensions for both INSTALL and LOAD.

require-env LOCAL_EXTENSION_REPO

statement ok
SET custom_extension_repository='{LOCAL_EXTENSION_REPO}';

statement ok
SET allow_community_extensions=false;

query T
SELECT current_setting('allow_community_extensions')::VARCHAR;
----
false

# h3 is a DuckDB Community extension. With community signing keys disabled,
# downloading it may succeed but installation must be rejected at signature validation.
statement error
INSTALL h3 FROM community;
----
<REGEX>:.*signature.*

# mssql was installed by the battery bootstrap but is deliberately not loaded
# in this profile. Loading its community-signed binary must also be rejected.
statement error
LOAD mssql;
----
<REGEX>:.*signature.*
